# Copy to .env and fill in. .env is gitignored — never commit real values.

DATABASE_URL="file:./dev.db"

# Discord Developer Portal → your application → Bot tab
DISCORD_TOKEN=""
# Right-click the StoryTime server / announcements channel with Developer Mode
# enabled in Discord settings, then "Copy Server ID" / "Copy Channel ID"
DISCORD_GUILD_ID=""
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=""

# The ID segment from the Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
PLAYLIST_SHEET_ID=""

# Optional — enables auto-filling a frown-face image into a member's cell
# when a week completes without them submitting an entry. Requires a
# Google Cloud service account with Editor access on the playlist sheet
# (share the sheet with the account's client_email). Leave unset to
# disable this feature; every other feature works fine without it.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=""
# Optional — defaults to a stable "Mr. Incredible mad" reaction image.
FROWN_IMAGE_URL=""

# Optional - st-tools hub integration (Going / Maybe / Not going buttons,
# /idea, per-minute nudge and reminder tick). Both must be set; leave unset
# to disable just those. BOT_API_SECRET must equal st-tools BOT_API_SECRET.
ST_TOOLS_URL=""
BOT_API_SECRET=""
